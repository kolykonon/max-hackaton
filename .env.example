# Локальный запуск: cp .env.example .env && docker compose up -d --build → http://localhost:8080
# Для сервера — блок «На сервере заменить» в конце файла

# ── Postgres ──
# В Docker — postgres:5432. Бэк без Docker (uv run uvicorn …) — localhost:5434
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kaplya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── Бот MAX ──
# Обязателен: без него бэк не стартует. Для локального API подойдёт любая строка,
# но бот и вход из MAX работают только с настоящим токеном из кабинета MAX
MAX_BOT_TOKEN=local-placeholder
# Имя бота без @ — для реферальных ссылок https://max.ru/<бот>?startapp=ref_...
MAX_BOT_USERNAME=t726_hakaton_max_bot
# Пусто — адрес API MAX по умолчанию
MAX_API_BASE_URL=
# polling — локально, webhook — на сервере с HTTPS (сервис bot в compose всегда polling)
MAX_MODE=polling
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
# Папка с сертификатами НУЦ Минцифры для запросов к API MAX. По умолчанию certs/ в корне
# репозитория, в Docker её монтирует compose — обычно задавать не нужно
# SSL_CERTS_DIR=
# Куда ведёт кнопка «Открыть приложение» в боте
WEBAPP_URL=http://localhost:8080

# ── Веб (Caddy) ──
# Локально: обычный HTTP без сертификата. Порты 8080/8443 — если 80/443 заняты
DOMAIN=:80
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

# ── Режимы ──
# Демо-эндпоинты /demo/* (сброс профиля, напоминание, засчитать донацию)
DEMO_MODE=true
# Вне MAX нет initData — пользователь задаётся заголовком X-Dev-User-Id
AUTH_DEV_MODE=true
# id пользователя, который фронт шлёт в X-Dev-User-Id. Зашивается при сборке фронта
VITE_DEV_USER_ID=1
# true — фронт на моках MSW, без запросов к бэку
VITE_USE_MOCKS=false

# ── На сервере заменить ──
# MAX_BOT_TOKEN=<токен из кабинета MAX>
# WEBAPP_URL=https://<домен>
# MAX_MODE=webhook, MAX_WEBHOOK_URL=https://<домен>/api/v1/webhook/max, MAX_WEBHOOK_SECRET=<случайная строка>
#   и один раз подписать бота: docker compose exec backend uv run --no-sync python -m scripts.subscribe_webhook
# DOMAIN=<домен>             — Caddy сам выпустит сертификат Let's Encrypt
# удалить WEB_HTTP_PORT и WEB_HTTPS_PORT — нужны порты 80/443
# AUTH_DEV_MODE=false        — иначе любой зайдёт под чужим id через X-Dev-User-Id
# VITE_DEV_USER_ID=          — пусто
# POSTGRES_PASSWORD=<надёжный пароль>
