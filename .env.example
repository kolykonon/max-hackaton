# Локальная проверка жюри: обязательно заполнить только токен своего бота MAX.
# Никогда не коммитьте .env. Остальные значения подходят для Docker Compose.
MAX_BOT_TOKEN=
# Необязательно: без @; при пустом значении определяется через GET /me.
MAX_BOT_USERNAME=
# Необязательно: HTTPS API MAX; Authorization передаётся заголовком.
MAX_API_BASE_URL=https://platform-api2.max.ru
# Необязательно: polling для локального запуска. webhook требует настройки MAX.
MAX_MODE=polling
# Необязательно: URL HTTPS /api/v1/webhook/max для scripts/subscribe_webhook.py.
MAX_WEBHOOK_URL=
# Необязательно при polling; секрет заголовка вебхука, задаётся для webhook.
MAX_WEBHOOK_SECRET=
# Необязательно: срок действия MAX initData в секундах.
INIT_DATA_TTL=86400
# Необязательно: папка дополнительных доверенных сертификатов внутри контейнера.
SSL_CERTS_DIR=/certs
# Устаревшая настройка: код не читает URL при открытии приложения.
# Привязку HTTPS-адреса к боту делают организаторы в MAX, не через эту переменную.
WEBAPP_URL=

# Необязательно: внутренние параметры PostgreSQL; порт наружу не публикуется.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kaplya
POSTGRES_USER=postgres
# Для локального изолированного стенда пароль не нужен; на сервере задать свой.
POSTGRES_PASSWORD=
# Только локальный стенд: trust в отдельной внутренней сети Docker без host-порта.
# В compose.prod.yaml принудительно используется scram-sha-256 и нужен пароль.
POSTGRES_HOST_AUTH_METHOD=trust

# Необязательно: префикс API; менять вместе с VITE_API_BASE_URL и прокси.
API_V1_PREFIX=/api/v1
# Локальная веб-проверка вне MAX: общедоступный тестовый пользователь, без реальных ПД.
# На сервере обязательно false и пустой VITE_DEV_USER_ID, затем пересборка web.
AUTH_DEV_MODE=true
# Демо-операции: сброс профиля и имитация донации. На сервере false.
DEMO_MODE=true
# Необязательно: HTTP-адрес Caddy; для локального туннеля оставить :8080.
DOMAIN=:8080
# Необязательно: локальный порт сайта на 127.0.0.1, пример http://localhost:8088.
WEB_HTTP_PORT=8088
# Только серверная надстройка, локально не публикуется.
WEB_HTTPS_PORT=443
# Совместимость: список origin через запятую, CORS-middleware в приложении нет.
CORS_ORIGINS=http://localhost:8088

# Необязательно: параметры сборки frontend, применять через up -d --build web.
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=false
# Тестовый пользователь вне MAX; внутри MAX всегда используется подписанный initData.
VITE_DEV_USER_ID=1
# Только Vite при разработке без Docker (в контейнерной сборке не используется).
API_PROXY_TARGET=http://127.0.0.1:8000
# Необязательно: серверная надстройка. Локально не задавать.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
