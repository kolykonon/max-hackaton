# Веб-сервер (сервис web в compose.yaml, ТЗ §2):
#   HTTPS для мини-приложения MAX, статика фронта и /api/* → backend.
# DOMAIN берётся из .env. На сервере — домен (сертификат Let's Encrypt выпустится сам),
# локально — localhost (самоподписанный) или :80 (обычный HTTP без сертификата).

{$DOMAIN:localhost} {
	encode zstd gzip

	# API и вебхук бота. Префикс /api/v1 не срезаем — бэк слушает те же пути
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Файлы в /assets с хешем в имени — кешируем навсегда
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html не кешируем, иначе после деплоя MAX откроет старую версию
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "no-cache"
		}

		file_server
	}
}
