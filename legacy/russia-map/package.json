{
  "name": "kaplya-russia-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "python3 scripts/import_data.py && node scripts/build_geometry.mjs && python3 scripts/generate_demo.py && node scripts/finalize.mjs",
    "geocode": "python3 scripts/geocode.py",
    "test": "node --test tests/*.test.mjs",
    "start": "python3 scripts/serve.py",
    "test:geocode": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "d3": "7.9.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "mapshaper": "0.6.113"
  }
}
